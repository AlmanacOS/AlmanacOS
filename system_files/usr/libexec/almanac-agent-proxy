#!/usr/bin/python3
"""almanac-agent-proxy — a filtering CONNECT proxy for agent sandboxes.

Why a proxy and not a firewall
------------------------------
The spec's original design was a firewalld policy scoped to the sandbox's podman
network. That cannot work. libkrun defaults to TSI — transparent socket
impersonation — where the guest has no IP address and no network interface at
all: its connect() calls are serviced by the VMM process, which makes them as
ordinary host sockets. There is no guest address for a firewall rule to match.
libkrun's own README says as much: apply on the VMM whatever restrictions you
want to apply on the guest.

And even with a real interface, an IP allowlist would not survive contact with
reality. Every endpoint these agents talk to sits behind a CDN with rotating
addresses. An allowlist of IPs is not merely awkward to maintain, it is wrong
within the week. Hostnames are the only granularity at which the policy can be
written down and stay true, and the only place the hostname is still legible is
the CONNECT request, before TLS begins.

What this does and does not do
------------------------------
It reads the hostname from `CONNECT host:port`, checks it against an allowlist,
and either splices the connection through or refuses it. There is no TLS
interception: it never sees, and could not see, anything inside the tunnel. No
CA is generated and nothing is injected into the guest's trust store.

It is *policy*, not *enforcement*. A guest that ignores HTTPS_PROXY and opens a
socket directly is not affected by anything here. Enforcement is a property of
the network namespace the VMM runs in — see `agentbox --net` — and this proxy is
what makes a restricted network usable rather than what makes it restricted.

Being clear about that split is the point. A filtering proxy that is described
as a security boundary is worse than no proxy, because it invites people to run
things they would otherwise think twice about.
"""

import argparse
import fnmatch
import os
import select
import socket
import socketserver
import sys
import threading

DEFAULT_PORT = 18080
SYSTEM_ALLOWLIST = "/usr/share/almanac/agent-egress.conf"
USER_ALLOWLIST = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "almanac", "agent-egress.conf",
)

# Only the two ports a CONNECT tunnel has any business reaching. Without this,
# an allowlisted hostname doubles as permission to reach every service on that
# host, which is not what anyone means by allowlisting a hostname.
ALLOWED_PORTS = {80, 443}

BUFSIZE = 65536


def log(*args):
    print(*args, file=sys.stderr, flush=True)


class Allowlist:
    """Hostname patterns, reloaded on change so edits do not need a restart."""

    def __init__(self, paths):
        self.paths = paths
        self.patterns = []
        self._stamps = {}
        self.reload()

    def _current_stamps(self):
        stamps = {}
        for path in self.paths:
            try:
                stamps[path] = os.stat(path).st_mtime_ns
            except FileNotFoundError:
                stamps[path] = None
        return stamps

    def reload(self):
        patterns = []
        for path in self.paths:
            try:
                with open(path) as handle:
                    for line in handle:
                        line = line.split("#", 1)[0].strip()
                        if line:
                            patterns.append(line.lower())
            except FileNotFoundError:
                continue
        self.patterns = patterns
        self._stamps = self._current_stamps()

    def maybe_reload(self):
        if self._current_stamps() != self._stamps:
            self.reload()
            log(f"allowlist reloaded: {len(self.patterns)} pattern(s)")

    def permits(self, host):
        host = host.lower().rstrip(".")
        for pattern in self.patterns:
            # fnmatch so that "*.example.com" works. Note it does NOT match the
            # bare apex, which is deliberate: listing a wildcard should not
            # silently grant the parent domain too.
            if host == pattern or fnmatch.fnmatch(host, pattern):
                return True
        return False


def splice(a, b):
    """Pump bytes both ways until either side hangs up."""
    sockets = [a, b]
    try:
        while True:
            readable, _, errored = select.select(sockets, [], sockets, 300)
            if errored or not readable:
                return
            for source in readable:
                target = b if source is a else a
                data = source.recv(BUFSIZE)
                if not data:
                    return
                target.sendall(data)
    except OSError:
        return


class Handler(socketserver.StreamRequestHandler):
    timeout = 60

    def _refuse(self, code, reason, detail=""):
        body = (detail + "\n").encode() if detail else b""
        self.wfile.write(
            f"HTTP/1.1 {code} {reason}\r\n"
            f"Content-Length: {len(body)}\r\n"
            "Content-Type: text/plain\r\n"
            "Connection: close\r\n\r\n".encode() + body
        )

    def handle(self):
        try:
            request = self.rfile.readline(65536).decode("latin-1").strip()
        except (OSError, UnicodeDecodeError):
            return
        if not request:
            return

        parts = request.split()
        if len(parts) < 3 or parts[0].upper() != "CONNECT":
            # Everything these agents do is HTTPS. Saying so plainly beats
            # half-implementing a forward proxy that works for some traffic.
            self._refuse(501, "Not Implemented",
                         "almanac-agent-proxy only handles CONNECT (HTTPS).")
            log(f"DENY  non-CONNECT: {request[:80]}")
            return

        # Drain the remaining request headers.
        while True:
            line = self.rfile.readline(65536)
            if line in (b"\r\n", b"\n", b""):
                break

        target = parts[1]
        host, _, port_text = target.rpartition(":")
        if not host:
            self._refuse(400, "Bad Request", "expected CONNECT host:port")
            return
        host = host.strip("[]")
        try:
            port = int(port_text)
        except ValueError:
            self._refuse(400, "Bad Request", "expected CONNECT host:port")
            return

        allowlist = self.server.allowlist
        allowlist.maybe_reload()

        if port not in ALLOWED_PORTS:
            self._refuse(403, "Forbidden", f"port {port} is not permitted")
            log(f"DENY  {host}:{port} (port)")
            return

        if not allowlist.permits(host):
            self._refuse(
                403, "Forbidden",
                f"{host} is not on the agent egress allowlist.\n"
                f"Add it with: ujust almanac-agent-egress allow {host}",
            )
            log(f"DENY  {host}:{port}")
            return

        try:
            upstream = socket.create_connection((host, port), timeout=30)
        except OSError as exc:
            self._refuse(502, "Bad Gateway", f"cannot reach {host}:{port}: {exc}")
            log(f"FAIL  {host}:{port} ({exc})")
            return

        log(f"ALLOW {host}:{port}")
        self.wfile.write(b"HTTP/1.1 200 Connection Established\r\n\r\n")
        self.wfile.flush()

        upstream.settimeout(None)
        self.connection.settimeout(None)
        try:
            splice(self.connection, upstream)
        finally:
            upstream.close()


class TCPProxy(socketserver.ThreadingTCPServer):
    daemon_threads = True
    allow_reuse_address = True


class UnixProxy(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--port", type=int,
                        default=int(os.environ.get("ALMANAC_AGENT_PROXY_PORT",
                                                   DEFAULT_PORT)))
    parser.add_argument("--bind", default="127.0.0.1")
    parser.add_argument(
        "--unix-socket", default=os.environ.get("ALMANAC_AGENT_PROXY_SOCKET"),
        help="Also listen on this AF_UNIX path. This exists so the strict "
             "enforcement mode can be tested: under --network none the VMM's "
             "namespace has no route anywhere, and a bind-mounted socket would "
             "be the single deliberate hole. Whether libkrun's TSI carries a "
             "bind-mounted AF_UNIX socket into the guest is unverified — "
             "`agentbox egress probe` is what answers it.")
    parser.add_argument("--allowlist", action="append", default=None)
    args = parser.parse_args()

    paths = args.allowlist or [SYSTEM_ALLOWLIST, USER_ALLOWLIST]
    allowlist = Allowlist(paths)

    log(f"almanac-agent-proxy: {len(allowlist.patterns)} pattern(s) from "
        f"{', '.join(paths)}")

    servers = []

    tcp = TCPProxy((args.bind, args.port), Handler)
    tcp.allowlist = allowlist
    servers.append(tcp)
    log(f"listening on {args.bind}:{args.port}")

    if args.unix_socket:
        if os.path.exists(args.unix_socket):
            os.unlink(args.unix_socket)
        os.makedirs(os.path.dirname(args.unix_socket), exist_ok=True)
        unix = UnixProxy(args.unix_socket, Handler)
        unix.allowlist = allowlist
        os.chmod(args.unix_socket, 0o600)
        servers.append(unix)
        log(f"listening on {args.unix_socket}")

    for server in servers[1:]:
        threading.Thread(target=server.serve_forever, daemon=True).start()
    try:
        servers[0].serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        for server in servers:
            server.server_close()


if __name__ == "__main__":
    main()
