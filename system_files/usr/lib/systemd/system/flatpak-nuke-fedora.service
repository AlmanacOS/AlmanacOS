[Unit]
Description=Remove Fedora flatpak repositories
# The base image's flatpak-add-flathub-repos.service adds fedora and
# fedora-testing (disabled) alongside flathub. Without this ordering we race it
# and it re-adds what we just deleted.
Wants=flatpak-add-flathub-repos.service
After=flatpak-add-flathub-repos.service
Before=flatpak-preinstall.service
Before=flatpak-system-helper.service
# Make sure we run before the Fedora service if it exists
Before=flatpak-add-fedora-repos.service
ConditionPathExists=/usr/bin/flatpak

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/almanac-flatpak-nuke-fedora --system

[Install]
WantedBy=multi-user.target
