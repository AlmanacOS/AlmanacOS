# The AlmanacOS live ISO image.
#
# This is AlmanacOS itself with a live session and an installer bolted on. It is
# not a separate OS: the ISO boots this rootfs as a squashfs, you get the real
# KDE desktop, and Anaconda installs the payload embedded alongside it.
#
# Titanoboa turns this container into the ISO. The contract is that the
# container carries everything the ISO needs — boot menu, kernel, initramfs, EFI
# binaries — so there is no build-side config file anywhere. See
# docs/installer/SETUP.md.
#
# Must be built with:
#     --cap-add sys_admin --security-opt label=disable --squash
# because build.sh runs podman inside the build to embed the install payload,
# and regenerates the initramfs. `just build-iso-image` passes these.

# The image the ISO is made of and the image it installs are the same build.
# Anything else means shipping an installer that lays down a system nobody
# tested the live environment against.
FROM ghcr.io/clemperorpenguin/almanacos:latest

COPY ./src /src

RUN --mount=type=cache,target=/var/tmp/libdnf5,id=libdnf5 \
    /src/build.sh

RUN rm -rf /src
